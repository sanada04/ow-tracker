Options -Indexes -MultiViews
DirectorySlash Off
ErrorDocument 404 /404.html

RewriteEngine On

# Certificate renewal checks must stay reachable over HTTP.
RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Paths without a language go to the visitor's language.
RewriteCond %{REQUEST_URI} !^/(ja|en|ko)(/|$)
RewriteCond %{REQUEST_URI} !^/_next/
RewriteCond %{REQUEST_URI} !\.
RewriteRule ^ /lang-redirect.php [L]

# One prebuilt page serves every player. Popular matchups have their own page at
# one address; the reversed URL redirects there and the rest share a single page.
RewriteRule ^(ja|en|ko)/players/([^/]+)$ /player-page.php?lang=$1&id=$2 [B,L,QSA]
# The patterns exclude dots because [L] reruns these rules on the rewritten .html path.
RewriteCond %{DOCUMENT_ROOT}/$1/heroes/$3/vs/$2.html -f
RewriteCond %{DOCUMENT_ROOT}/$1/heroes/$2/vs/$3.html !-f
RewriteRule ^(ja|en|ko)/heroes/([^/.]+)/vs/([^/.]+)$ /$1/heroes/$3/vs/$2 [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/$1/heroes/$2/vs/$3.html -f
RewriteRule ^(ja|en|ko)/heroes/([^/.]+)/vs/([^/.]+)$ /$1/heroes/$2/vs/$3.html [L]
RewriteRule ^(ja|en|ko)/heroes/[^/.]+/vs/[^/.]+$ /$1/heroes/_/vs/_.html [L]

# Canonical URLs have no trailing slash or .html.
RewriteRule ^(.+)/$ /$1 [R=301,L]
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+)$ /$1.html [L]

# Deploys overwrite the server copy, so this handler must stay here.
# When changing the PHP version in cPanel, update this block too.
# php -- BEGIN cPanel-generated handler, do not edit
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php83 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
